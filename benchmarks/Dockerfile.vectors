# Build from the exact pipeline image digest measured by full_pipeline.py.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /bin/uv
COPY benchmarks/ /app/benchmarks/
RUN uv pip install --python /app/.venv/bin/python --no-deps --require-hashes \
      -r /app/benchmarks/vector-requirements.lock \
    && python /app/benchmarks/vector_runtime.py --bake /opt/er-vector-model \
    && python /app/benchmarks/vector_runtime.py --doctor /opt/er-vector-model
ENV HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false

{
  "name": "er-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone cloud UI for the entity-resolution engine (see docs/frontend-design.md)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "sharp"
    ],
    "overrides": {
      "vite": "8.3.5"
    }
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "bash dev/kill-servers.sh && playwright test",
    "test:e2e:full": "playwright test --config playwright.e2e.config.ts",
    "gen:api": "node scripts/gen-api-types.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "authz:check": "node scripts/check-bff-authz.mjs",
    "check": "eslint . --max-warnings 0 && prettier --check . && tsc --noEmit && node scripts/check-bff-authz.mjs && vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.21",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "ulidx": "^2.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.x",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}

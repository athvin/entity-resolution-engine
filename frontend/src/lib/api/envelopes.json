{
  "GET /healthz": { "envelope": "wrapped", "key": "status" },
  "GET /v1/audit": { "envelope": "bare" },
  "GET /v1/jobs": { "envelope": "bare" },
  "GET /v1/orgs": { "envelope": "bare" },
  "GET /v1/orgs/{org}": { "envelope": "record", "keys": ["id", "name", "state", "active_config_version", "drop_root", "resources"] },
  "GET /v1/orgs/{org}/assertions": { "envelope": "page", "key": "items" },
  "GET /v1/orgs/{org}/assertions/contradictions": { "envelope": "wrapped", "key": "contradictions" },
  "GET /v1/orgs/{org}/audit": { "envelope": "bare" },
  "GET /v1/orgs/{org}/blocking-estimate": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/config": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/config/versions": { "envelope": "bare" },
  "GET /v1/orgs/{org}/config/versions/{version}": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/data-quality": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/duplicates": { "envelope": "record", "keys": ["items", "snapshot", "next_cursor"] },
  "GET /v1/orgs/{org}/golden-records": { "envelope": "arrow", "cursor_in": "headers" },
  "GET /v1/orgs/{org}/golden-records/{entity_id}": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/imports": { "envelope": "page", "key": "items" },
  "GET /v1/orgs/{org}/imports/recent": { "envelope": "bare" },
  "GET /v1/orgs/{org}/insights": { "envelope": "record", "keys": ["snapshot", "series"] },
  "GET /v1/orgs/{org}/insights/sources": { "envelope": "record", "keys": ["snapshot", "run_id", "sources"] },
  "GET /v1/orgs/{org}/jobs": { "envelope": "wrapped", "key": "jobs" },
  "GET /v1/orgs/{org}/jobs/{job_id}": { "envelope": "bare" },
  "GET /v1/orgs/{org}/labeling/next": { "envelope": "record", "keys": ["items", "snapshot", "threshold", "band", "coverage"] },
  "GET /v1/orgs/{org}/labels": { "envelope": "wrapped", "key": "labels" },
  "GET /v1/orgs/{org}/lexicon": { "envelope": "wrapped", "key": "pairs" },
  "GET /v1/orgs/{org}/match-preview": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/match-scores": { "envelope": "record", "keys": ["items", "snapshot", "next_cursor"] },
  "GET /v1/orgs/{org}/merge-plans": { "envelope": "wrapped", "key": "items" },
  "GET /v1/orgs/{org}/metrics": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/models": { "envelope": "record", "keys": ["items", "active"] },
  "GET /v1/orgs/{org}/models/{name}/versions/{version}": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/quality": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/records": { "envelope": "record", "keys": ["items", "snapshot"] },
  "GET /v1/orgs/{org}/reviews": { "envelope": "record", "keys": ["items", "snapshot", "next_cursor", "unscored_hidden"] },
  "GET /v1/orgs/{org}/reviews/{review_id}": { "envelope": "scalar" },
  "GET /v1/orgs/{org}/runs": { "envelope": "bare" },
  "GET /v1/orgs/{org}/runs/{run_id}/entity-events": { "envelope": "record", "keys": ["items", "run_id", "snapshot", "next_cursor"] },
  "GET /v1/orgs/{org}/schedules": { "envelope": "bare" },
  "GET /v1/orgs/{org}/segments": { "envelope": "wrapped", "key": "segments" },
  "GET /v1/orgs/{org}/staged": { "envelope": "wrapped", "key": "pending_count" },
  "GET /v1/orgs/{org}/webhooks": { "envelope": "bare" },
  "GET /v1/orgs/{org}/webhooks/deliveries": { "envelope": "wrapped", "key": "deliveries" },
  "GET /v1/orgs/{org}/webhooks/events": { "envelope": "wrapped", "key": "events" }
}

# erserver control plane (server-side only — nothing here is ever exposed to the browser)
ERSERVER_BASE_URL=http://localhost:8000
ERSERVER_OPERATOR_TOKEN=dev-operator-token

# BFF-owned tables live in schema `erweb` of the control-plane Postgres
ERWEB_DATABASE_URL=postgresql://postgres:er@localhost:5433/postgres

# Session cookie integrity (any long random string; `openssl rand -hex 32`)
ERWEB_SESSION_SECRET=change-me-to-a-long-random-string-0000

# 32-byte base64 AES-256-GCM key for the org-credential vault (`openssl rand -base64 32`)
ERWEB_CREDENTIAL_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Session cookies are Secure by default; set to 1 ONLY for plain-HTTP localhost.
ERWEB_INSECURE_COOKIES=1

# Assistant (optional until the Assistant screen ships)
ANTHROPIC_API_KEY=
ERWEB_ASSISTANT_MODEL=claude-opus-5

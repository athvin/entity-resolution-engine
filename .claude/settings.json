{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"$CLAUDE_PROJECT_DIR/.tools/bin/cargo-agents\"; [ -x \"$B\" ] || exit 0; cd \"$CLAUDE_PROJECT_DIR/rust\" || exit 0; SYMPOSIUM_HOME=\"$CLAUDE_PROJECT_DIR/.symposium\" exec \"$B\" hook claude session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(aws *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(terraform *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(kubectl *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(helm *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/aws-write-guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(aws organizations *)",
      "Bash(aws iam delete-* *)",
      "Bash(aws kms schedule-key-deletion *)",
      "Bash(aws eks delete-cluster *)",
      "Bash(aws rds delete-db-cluster *)",
      "Bash(aws rds delete-db-instance *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket *)"
    ]
  },
  "enabledMcpjsonServers": ["aws"],
  "enabledPlugins": {
    "terraform@claude-plugins-official": true
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/symposium-session-start.sh\" claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(aws *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(terraform *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(kubectl *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/aws-write-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(helm *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/aws-write-guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(aws organizations *)",
      "Bash(aws iam delete-* *)",
      "Bash(aws kms schedule-key-deletion *)",
      "Bash(aws eks delete-cluster *)",
      "Bash(aws rds delete-db-cluster *)",
      "Bash(aws rds delete-db-instance *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket *)"
    ]
  },
  "enabledMcpjsonServers": ["aws"],
  "enabledPlugins": {
    "terraform@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  }
}

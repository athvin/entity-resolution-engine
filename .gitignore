# Loop working state: change plans, gate receipts, logs, per-run transcripts.
# Never committed -- receipts must not be forgeable through a merge.
.loop/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
# Written next to the profile by every dbt invocation: a per-user anonymous-usage
# id. It is machine-local, so committing it would put one developer's id in every
# clone and every container image.
dbt/profiles/.user.yml

# Pipeline outputs. Both are S3 working directories, not sources of truth, but
# the directory itself must exist in a fresh clone: docker/Dockerfile COPYs it and
# artifacts/ is a Compose bind mount. Ignore the contents, track the marker.
# The pattern must be `dir/*`, not `dir/`: git cannot re-include a file whose
# parent directory is itself excluded, so `artifacts/` + `!artifacts/.gitkeep`
# silently keeps the marker untracked.
artifacts/*
!artifacts/.gitkeep
models/*
!models/.gitkeep
*.duckdb
*.duckdb.wal

.DS_Store

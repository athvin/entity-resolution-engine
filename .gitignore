# Python environment and generated caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# dbt dependencies, build output and machine-local usage ID
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/profiles/.user.yml

# Generated run output and local databases
artifacts/
*.duckdb
*.duckdb.wal
.DS_Store

# Frontend build/test output and dev-stack state (frontend/.gitignore has the rest)
frontend/node_modules/
frontend/.next/
frontend/playwright-report/
frontend/test-results/
frontend/dev/.state/

# Terraform — local state (until migrated to the S3 backend), caches, and
# tfvars (root emails stay out of a public repo). Lock files ARE committed.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars

// The development container for this repo — see .claude/skills/ci-and-supply-chain/references/devcontainer.md, and
// .devcontainer/Dockerfile for why mold is mandatory and cmake is absent.
//
// `cacheFrom` is what makes "Reopen in Container" a pull rather than a
// ~40-minute first build, which #584 identifies as the difference between this
// being used and being abandoned. The image it names is published to GHCR by
// .github/workflows/devcontainer.yml on every push to `main`. GHCR because it
// needs NO secret, and this repo holding zero secrets is an invariant worth
// keeping; ECR would require the collaborator to hold AWS credentials and run
// `aws ecr get-login-password` before the container would open at all.
{
  "name": "entity-resolution-engine",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "ghcr.io/athvin/entity-resolution-engine-devcontainer:main"
  },
  "features": {
    // Pinned to an exact feature version, not the `:2` floating major, for the
    // same reason every `uses:` in .github/workflows is pinned to a SHA: a
    // moving reference makes the image non-reproducible and a regression
    // unattributable. `nodeGypDependencies` off — nothing here builds a native
    // node addon, and it would pull in python3 and build tooling for nothing.
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22",
      "nodeGypDependencies": false
    }
  },
  "containerEnv": {
    // NOT optional on aarch64. Without mold the bundled-DuckDB link fails with
    // `undefined reference to duckdb_register_static_extensions` — see the
    // Dockerfile header. scripts/ci/devcontainer-smoke.sh asserts this is still
    // set, because it is the kind of line a local override silently drops.
    "RUSTFLAGS": "-C link-arg=-fuse-ld=mold",
    // Matches the DSN rust.yml hands its `postgres:16-alpine` service, so
    // `make check-e2e` needs no argument in here. The server is started by
    // scripts/devcontainer-poststart.sh.
    "ER_TEST_PG_DSN": "host=localhost port=5432 user=er password=er dbname=er",
    // THE BUILD DIRECTORY LIVES OUTSIDE THE WORKSPACE, and that is the single
    // most important line in this file for a Windows reader. `rust/target` is
    // 30–80 GB in this repo (the primary checkout's was measured at 132 GB).
    // Left at its default it would sit on the workspace bind mount — which on
    // Windows is a 9p/virtiofs share, making it both ruinously slow and able to
    // fill Docker Desktop's WSL2 virtual disk through the host filesystem.
    //
    // Pointing it at $HOME puts it on the `er-cargo-target` volume below, in
    // the Docker VM's own filesystem. It also makes copy-up possible: see the
    // Dockerfile's mount-point stanza for why a workspace-relative volume
    // cannot be made writable without root.
    "CARGO_TARGET_DIR": "/home/vscode/.cache/er/cargo-target"
    // NO CARGO_HOME HERE, AND IT IS NOT AN OVERSIGHT. Setting it is futile: the
    // base image's /etc/bash.bashrc carries an unconditional
    // `export CARGO_HOME="/usr/local/cargo"`, which the CLI's `userEnvProbe`
    // re-applies over this block and every interactive shell re-applies again.
    // A value set here reads back as /usr/local/cargo, so the only thing it
    // would buy is a mount pointing somewhere cargo never looks.
    //
    // CARGO_TARGET_DIR above survives precisely because nothing in that bashrc
    // mentions it — which is the asymmetry to remember, not a rule about
    // containerEnv. scripts/ci/devcontainer-smoke.sh asserts it is still set,
    // because if it ever stops being, the 30–80 GB silently lands on the
    // workspace bind mount: the exact Windows hazard this file exists to avoid,
    // with nothing going red.
  },
  // NAMED VOLUMES, so the heavy caches never touch the host filesystem. EVERY
  // TARGET HERE MUST BE A PATH THE Dockerfile PRE-CREATES, because that is what
  // makes Docker's copy-up hand the volume over writable — and it must be
  // pre-created so that it SURVIVES the uid rewrite `devcontainers/ci` performs:
  // owned by the user under $HOME, or mode-permissive outside it. The Dockerfile's
  // mount-point stanza argues both; adding a volume means adding its directory
  // there too, with the right one of those two treatments.
  //
  // The cost is that `docker volume rm` is how you reclaim the space, not
  // deleting a folder — .claude/skills/ci-and-supply-chain/references/devcontainer.md says so.
  "mounts": [
    // The downloaded crate registry. CARGO_HOME is /usr/local/cargo and cannot
    // be moved (see containerEnv above), so this one lives outside $HOME and is
    // kept writable by mode rather than by owner.
    "source=er-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    // Where CARGO_TARGET_DIR above points. This is the 30–80 GB one.
    "source=er-cargo-target,target=/home/vscode/.cache/er/cargo-target,type=volume",
    // DuckDB downloads its extensions here on first use (the same path
    // rust.yml caches as `~/.duckdb/extensions`). Without this volume every
    // rebuild re-fetches them.
    "source=er-duckdb,target=/home/vscode/.duckdb,type=volume"
  ],
  // `frontend/node_modules` is DELIBERATELY NOT a volume, unlike the three
  // above. It is 783 MB — real, but three orders of magnitude off the hazard
  // this file is built around — and it is the one cache that cannot live
  // outside the workspace, since pnpm's symlink layout has to sit beside
  // `frontend/package.json`. A volume there would be workspace-relative, which
  // copy-up cannot reach, and keeping it would mean keeping the `sudo chown`
  // for one directory. Correctness over the last optimisation.
  //
  // It deliberately does NOT build — a postCreate that ran `make check` would
  // make first open the 40 minutes the prebuild exists to avoid.
  "postCreateCommand": "bash scripts/devcontainer-postcreate.sh",
  // Runs on every start, not just creation: there is no init system in the
  // container, so nothing else would bring Postgres back after a stop.
  "postStartCommand": "bash scripts/devcontainer-poststart.sh",
  "remoteUser": "vscode",
  // Advisory, and honoured by Codespaces rather than by local Docker — but it
  // is the one machine-readable place to state the figure a Windows reader
  // needs: a full `rust/target` plus the toolchain wants ~60 GB of headroom,
  // and Docker Desktop's WSL2 disk defaults well below that. A full disk
  // surfaces as `linking with cc failed`, which reads as a link error.
  "hostRequirements": {
    "storage": "64gb"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "frontend (next dev)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "hashicorp.terraform"
      ],
      "settings": {
        // Point rust-analyzer at the workspace root, which is `rust/` and not
        // the repo root (CLAUDE.md, Layout). Without this it finds no cargo
        // project and the whole editor experience silently degrades to plain
        // text — the single most likely "the container is broken" report.
        "rust-analyzer.linkedProjects": ["rust/Cargo.toml"],
        // `true` means "use a subdirectory of the existing target directory",
        // so rust-analyzer's `cargo check` stops contending with `make check`
        // for the Cargo.lock. Without it the editor goes dead for the whole
        // duration of a gate run — which is forty minutes on a cold build, and
        // exactly when you are waiting and most likely to go looking at code.
        //
        // It does duplicate artifacts, and this repo is unusually sensitive to
        // that (`rust/target` is 30–80 GB). The duplicate is `cargo check`
        // output rather than a second full build, so it is a fraction of that —
        // but it does land in the `er-cargo-target` volume, which is where to
        // look if that volume grows faster than expected.
        "rust-analyzer.cargo.targetDir": true,
        "eslint.workingDirectories": ["frontend"]
      }
    }
  }
}

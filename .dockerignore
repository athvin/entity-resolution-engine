# The image installs its own environment from uv.lock.
.git
.gitignore
.venv

# Generated data and dbt output
artifacts
dbt/target
dbt/dbt_packages
dbt/logs
dbt/profiles/.user.yml

# Caches and bytecode
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
**/.DS_Store

# Documentation and repository automation are not runtime inputs.
docs
README.md
CONTRIBUTING.md
DesignDoc.md
.github
